+fn test_framebuffer_session_gesture_uses_authenticated_focused_peer() {
+	directory := os.join_path(os.temp_dir(), 'vinix-fb-clipboard-${os.getpid()}')
+	mut server := fb_test_server(directory)!
+	mut desktop := Desktop{ canvas: new_canvas(800, 600) }
+	defer {
+		desktop.close_apps(); server.close(); os.rmdir_all(directory) or {}
+		unsafe { directory.free(); free(desktop.canvas.pixels) }
+	}
+	mut client := fb_test_client(mut desktop, mut server)!
+	defer { client.close(); unsafe { free(client) } }
+	mut app := desktop.apps[desktop.windows[0].app_index]
+	if mut app is FramebufferApp {
+		assert app.pid == os.getpid()
+		assert !desktop.session_sender_has_gesture(app.pid)
+		desktop.mark_session_gesture()
+		assert desktop.session_sender_has_gesture(app.pid)
+		desktop.hub.attached = true
+		now := monotonic_millis()
+		desktop.hub.actions_polled_at = now
+		assert !desktop.framebuffer_session_actions_due(now + 19)
+		assert desktop.framebuffer_session_actions_due(now + 20)
+		assert !desktop.session_sender_has_gesture(-1)
+		desktop.focus = 0
+		assert !desktop.session_sender_has_gesture(app.pid)
+		assert !desktop.framebuffer_session_actions_due(now + 20)
+		desktop.focus = desktop.windows[0].id
+		desktop.hub.gesture_at = monotonic_millis() - 6000
+		assert !desktop.session_sender_has_gesture(app.pid)
+		desktop.mark_session_gesture()
+		app.failed = true
+		assert !desktop.session_sender_has_gesture(app.pid)
+	} else { assert false }
+}
