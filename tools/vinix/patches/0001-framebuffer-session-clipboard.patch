+fn (d &Desktop) framebuffer_session_actions_due(now i64) bool {
+	if !d.hub.attached || now - d.hub.actions_polled_at < 20 { return false }
+	for w in d.windows {
+		if w.id != d.focus || w.app_index < 0 || w.app_index >= d.apps.len { continue }
